// Copia este archivo como Config/Secrets.xcconfig y completa los valores.
// Secrets.xcconfig está en .gitignore: nunca lo subas al repositorio.
// Recuerda escribir las URLs como https:/$()/host

SUPABASE_URL = https:/$()/tu-proyecto.supabase.co
SUPABASE_ANON_KEY = tu-llave-publicable
// USE_MOCK_ME = NO   // descomenta para usar la API real en Debug
// API_BASE_URL = https:/$()/api.tu-dominio.com/api
